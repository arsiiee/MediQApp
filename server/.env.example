# MediQ Ktor server configuration
# Copy to .env and fill in values before running locally.
# The server auto-runs Flyway migrations and DatabaseSeeder on startup.

# Server port
PORT=8099

# Database connection (PostgreSQL / Supabase for production)
MEDIQ_JDBC_URL=jdbc:postgresql://your-postgres-host:5432/mediq
MEDIQ_DB_USER=your-db-user
MEDIQ_DB_PASSWORD=your-db-password
DB_DRIVER=org.postgresql.Driver

# JWT signing secret — change in production
JWT_SECRET=your-secure-secret-change-in-production

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:4200,https://your-frontend-domain.example.com
