# MediQ Angular frontend environment variables
# Copy to .env and fill in values before building locally or deploying to Vercel.
# Set these in the Vercel dashboard under Settings > Environment Variables.

# Backend API (Ktor server on Render)
API_BASE_URL=http://localhost:8099

# BFF / auth proxy (Hono on Render)
BFF_BASE_URL=http://localhost:3000
