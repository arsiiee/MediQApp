<?xml version="1.0" encoding="utf-8"?>
<!--
  The MediQ API runs on the developer machine over plain HTTP during
  development. 10.0.2.2 is the host loopback as seen from the Android
  emulator; 127.0.0.1 is the device itself. Cleartext stays off everywhere
  else so a real device never talks to a plain-HTTP endpoint.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
