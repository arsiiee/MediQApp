<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows cleartext HTTP only to local dev addresses used when reaching the Ktor
    server running on the same machine as the app:
      - 10.0.2.2      : Android Emulator loopback to the host machine
      - 127.0.0.1     : Physical device via `adb reverse tcp:8099 tcp:8099`
      - 192.168.100.14: Physical device on the same Wi-Fi, no cable
                        (this PC's DHCP address; re-check with ipconfig if it
                        changes, and keep this entry in sync)

    All other traffic (production hosts) continues to require HTTPS.
    Remove or scope this config further before production release.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.100.14</domain>
    </domain-config>
</network-security-config>
